{
  "name": "kehai-qr-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Design scannable QR codes in the browser: URL, text, email, phone and Wi-Fi, with live scan verification. Part of the Kehai ecosystem.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "jsqr": "^1.4.0",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "typescript": "5.6",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
